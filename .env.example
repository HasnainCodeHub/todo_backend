# Backend Environment Configuration
# Phase 2.1 + Phase 2.3 + Phase 3 (AI Chatbot) + Vercel Deployment

# Database Configuration (Phase 2.1)
# Use Neon PostgreSQL or similar serverless Postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT Authentication (Phase 2.3)
# REQUIRED: Must match Better Auth frontend secret (BETTER_AUTH_SECRET)
JWT_SECRET=your-secure-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256

# AI Chatbot Configuration (Phase 3)
# REQUIRED: Google API key for the chat-orchestrator agent (Gemini)
GOOGLE_API_KEY=AIzaSyD06J748x0sYZ24e1mZzZ345678901234

# MCP Server URL - the URL where the MCP server is mounted
# For local development: http://localhost:8000/mcp
# For production: https://your-backend-url.vercel.app/mcp
MCP_SERVER_URL=http://localhost:8000/mcp

# Chat model configuration
CHAT_MODEL=gemini-2.5-flash
CHAT_CONTEXT_LIMIT=20

# Vercel Deployment Notes:
# Set these environment variables in Vercel Dashboard:
# - DATABASE_URL: Your Neon PostgreSQL connection string
# - JWT_SECRET: Must match BETTER_AUTH_SECRET from frontend
# - GOOGLE_API_KEY: Your Google API key for Gemini
# - MCP_SERVER_URL: Your production MCP server URL
